/build
/bin
/dist
/local-config.properties
/local-boot.properties
/build.properties
/.idea
*.iml
*~

# Python bytecode cache, generated by tools/combat's cross-importing package.
__pycache__/
*.pyc

# Redistributables and assets, not source. These are the shipped Hurricane
# payload (~350MB, with Release/ and lib/ holding duplicate copies of the same
# jars); tracking them would bloat history without making the fork any easier
# to diff against upstream. Restore them from the Hurricane release zip.
*.jar
/Release/
/lib/
# res/ is upstream payload, except our own Nurgling Imports menu-grid resources, which are
# fork source (generated by tools/gen-menugrid-res.py) and must survive updates. Git cannot
# re-include inside an ignored DIRECTORY, so ignore by glob and re-include the chain down.
/res/*
!/res/customclient/
/res/customclient/*
!/res/customclient/menugrid/
/res/customclient/menugrid/*
!/res/customclient/menugrid/NurglingImports.res
!/res/customclient/menugrid/NurglingImports/
/opt/
/AlarmSounds/
/midiFiles/
/MapIconsPresets/
/.updater-backup/
# Written by NLog at runtime, relative to whatever the client's working directory is -
# the repo root when it is run from a checkout. Player logs, not source.
/logs/
*.db
steamicon.gif

# AI / agent material — local development only, never published.
#
# Everything an assistant reads lives in exactly two places: the two root entry
# files the tools auto-load (AGENTS.md for Opencode/Deepseek/Reasonix, CLAUDE.md
# for Claude Code), and ai-docs/ which holds the knowledge base, the RAG tooling
# and the work plans. Per-tool runtime dirs (.claude/, .reasonix/) stay at the
# root because those tools require them there.
#
# CONTEXT.md, docs/adr/ and docs/agents/ are a third, unavoidable home: the
# engineering skills hard-code those paths at the repo root, so they cannot move
# into ai-docs/. They are still agent material, so they are still unpublished.
AGENTS.md
CLAUDE.md
/CONTEXT.md
/docs/adr/
/docs/agents/
/ai-docs/
/.logs/
.claude/
.reasonix/
reasonix.toml

# Loose scratch text at the repo root (session prompts, error dumps). Durable
# notes belong in ai-docs/plans/ instead.
/*.txt

# Agent runtime scratch (evidence, notepads, run state), same category as .claude/.
.omo/
